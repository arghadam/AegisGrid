export component TouchIdScanScreen inherits Rectangle {
    in property <string> statusmeldung: "";
    in property <bool> erfolgreich: false;
    in property <float> phase: 0;

    background: #010604;

    for grid-x in 24 : Rectangle {
        x: grid-x * 64px;
        width: 1px;
        height: parent.height;
        background: #06351a;
        opacity: 0.12;
    }

    for grid-y in 16 : Rectangle {
        y: grid-y * 56px;
        width: parent.width;
        height: 1px;
        background: #06351a;
        opacity: 0.12;
    }

    Rectangle {
        x: parent.width / 2 - 260px;
        y: parent.height / 2 - 260px;
        width: 520px;
        height: 520px;
        background: #020906;
        border-color: erfolgreich ? #00ff66 : #0b5c2b;
        border-width: 1px;

        Text {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: 30px;
            text: "AEGISGRID // BIOMETRISCHE VERIFIZIERUNG";
            color: #00ff66;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Image {
            x: parent.width / 2 - 145px;
            y: 78px;
            width: 290px;
            height: 300px;
            source: @image-url("../../../../assets/biometrics/fingerprint_realistic.png");
            image-fit: contain;
            opacity: erfolgreich ? 1.0 : 0.86;
        }

        Rectangle {
            x: 92px;
            y:
                105px
                + (
                    (
                        Math.sin(
                            root.phase * 4deg
                        )
                        + 1.0
                    )
                    / 2.0
                )
                * 255px;
            width: parent.width - 184px;
            height: 2px;
            background: #00ff66;
            opacity: erfolgreich ? 0.0 : 0.85;

        }

        Text {
            x: 30px;
            y: 410px;
            width: parent.width - 60px;
            height: 55px;
            text: root.statusmeldung;
            color: erfolgreich ? #00ff66 : #8cffaa;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
