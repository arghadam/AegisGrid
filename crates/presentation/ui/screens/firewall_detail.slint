component FirewallButton inherits Rectangle {
    in property <string> text: "";
    callback clicked();
    background: #03140a;
    border-color: #0b5c2b;
    border-width: 1px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #00ff66;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.clicked();
    }
}

export component FirewallDetailScreen inherits Rectangle {
    in property <string> hostname: "—";
    in property <string> status: "BEREIT";
    in property <string> firewall-status: "—";
    in property <string> profile: "—";
    in property <string> regeln: "—";

    callback aktualisieren();
    callback zurueck();

    background: #010604;

    for grid-x in 24 : Rectangle {
        x: grid-x * 64px;
        width: 1px;
        height: parent.height;
        background: #06351a;
        opacity: 0.10;
    }

    for grid-y in 16 : Rectangle {
        y: grid-y * 56px;
        width: parent.width;
        height: 1px;
        background: #06351a;
        opacity: 0.10;
    }

    Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: 68px;
        background: #03140a;
        border-color: #00ff66;
        border-width: 1px;

        FirewallButton {
            x: 14px;
            y: 14px;
            width: 120px;
            height: 40px;
            text: "< DASHBOARD";
            clicked => root.zurueck();
        }

        Text {
            x: 154px;
            width: 500px;
            height: parent.height;
            text: "AEGISGRID // FIREWALL-DETAILS";
            color: #00ff66;
            font-size: 19px;
            font-weight: 700;
            vertical-alignment: center;
        }

        FirewallButton {
            x: parent.width - 350px;
            y: 14px;
            width: 150px;
            height: 40px;
            text: "AKTUALISIEREN";
            clicked => root.aktualisieren();
        }

        Text {
            x: parent.width - 190px;
            width: 170px;
            height: parent.height;
            text: "HOST: " + root.hostname;
            color: #8cffaa;
            font-size: 10px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 18px;
        y: 104px;
        width: parent.width - 36px;
        height: 106px;
        background: #020906;
        border-color: #0b5c2b;
        border-width: 1px;

        Text {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: 18px;
            text: "FIREWALL-STATUS // " + root.status;
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Text {
            x: 16px;
            y: 42px;
            width: parent.width - 32px;
            height: 46px;
            text: root.firewall-status;
            color: #00ff66;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: 18px;
        y: 226px;
        width: 390px;
        height: parent.height - 244px;
        background: #000402;
        border-color: #0b5c2b;
        border-width: 1px;
        clip: true;

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: 18px;
            text: "PROFILE / SYSTEMOPTIONEN";
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 38px;
            width: parent.width - 28px;
            height: 1px;
            background: #0b5c2b;
        }

        Text {
            x: 14px;
            y: 52px;
            width: parent.width - 28px;
            height: parent.height - 66px;
            text: root.profile;
            color: #00ff66;
            font-size: 10px;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: 424px;
        y: 226px;
        width: parent.width - 442px;
        height: parent.height - 244px;
        background: #000402;
        border-color: #0b5c2b;
        border-width: 1px;
        clip: true;

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: 18px;
            text: "AKTIVE / KONFIGURIERTE FIREWALL-REGELN";
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 38px;
            width: parent.width - 28px;
            height: 1px;
            background: #0b5c2b;
        }

        Text {
            x: 14px;
            y: 52px;
            width: parent.width - 28px;
            height: parent.height - 66px;
            text: root.regeln;
            color: #00ff66;
            font-size: 9px;
            wrap: word-wrap;
        }
    }
}
