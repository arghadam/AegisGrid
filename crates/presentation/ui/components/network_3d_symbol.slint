export component Network3dSymbol inherits Rectangle {
    in property <string> status-text: "NETZWERK AKTIV";
    in property <string> center-text: "AEGIS";
    in property <bool> active: true;
    in property <float> phase: 0;

    background: #010805;
    border-color: active ? #00ff66 : #16512d;
    border-width: 1px;

    // Pulsierender 3D-Außenring
    Rectangle {
        x:
            parent.width * 0.10
            - (
                Math.mod(
                    root.phase,
                    90.0
                )
                / 90.0
            )
            * 8px;

        y:
            parent.height * 0.10
            - (
                Math.mod(
                    root.phase,
                    90.0
                )
                / 90.0
            )
            * 6px;

        width:
            parent.width * 0.80
            + (
                Math.mod(
                    root.phase,
                    90.0
                )
                / 90.0
            )
            * 16px;

        height:
            parent.height * 0.80
            + (
                Math.mod(
                    root.phase,
                    90.0
                )
                / 90.0
            )
            * 12px;

        background: transparent;

        border-color:
            active
            ? #00ff66
            : #16512d;

        border-width: 1px;
        border-radius: self.height / 2;

        opacity:
            0.55
            - (
                Math.mod(
                    root.phase,
                    90.0
                )
                / 90.0
            )
            * 0.45;
    }

    // Zweite versetzte Radar-Welle
    Rectangle {
        property <float> wave:
            Math.mod(
                root.phase + 45.0,
                90.0
            )
            / 90.0;

        x:
            parent.width * 0.10
            - wave * 10px;

        y:
            parent.height * 0.10
            - wave * 7px;

        width:
            parent.width * 0.80
            + wave * 20px;

        height:
            parent.height * 0.80
            + wave * 14px;

        background: transparent;

        border-color:
            active
            ? #8cffaa
            : #16512d;

        border-width: 1px;
        border-radius: self.height / 2;

        opacity:
            0.42
            - wave * 0.36;
    }

    // Parallax-Hintergrundebene
    Rectangle {
        property <angle> parallax-angle:
            root.phase * 1.2deg;

        x:
            parent.width * 0.14
            + Math.sin(
                parallax-angle
            )
            * 4px;

        y:
            parent.height * 0.16
            + Math.cos(
                parallax-angle
            )
            * 3px;

        width:
            parent.width * 0.72;

        height:
            parent.height * 0.68;

        background: transparent;

        border-color:
            active
            ? #0b7a38
            : #16512d;

        border-width: 1px;
        border-radius: self.height / 2;

        opacity: 0.30;
    }

    // Parallax-Mitte
    Rectangle {
        property <angle> parallax-angle:
            root.phase * -1.6deg;

        x:
            parent.width * 0.20
            + Math.cos(
                parallax-angle
            )
            * 3px;

        y:
            parent.height * 0.22
            + Math.sin(
                parallax-angle
            )
            * 2px;

        width:
            parent.width * 0.60;

        height:
            parent.height * 0.56;

        background: transparent;

        border-color:
            active
            ? #00ff66
            : #16512d;

        border-width: 1px;
        border-radius: self.height / 2;

        opacity: 0.20;
    }

    // Innerer dunkler Kern
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.18;
        width: parent.width * 0.64;
        height: parent.height * 0.64;

        background: #02140a;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.height / 2;
    }

    // Äußerer HUD-Ring
    Rectangle {
        x: parent.width * 0.10;
        y: parent.height * 0.10;
        width: parent.width * 0.80;
        height: parent.height * 0.80;

        background: transparent;
        border-color: active ? #00ff66 : #16512d;
        border-width: 1px;
        border-radius: self.height / 2;
    }

    // Mittlerer HUD-Ring
    Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.16;
        width: parent.width * 0.68;
        height: parent.height * 0.68;

        background: transparent;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.height / 2;
    }

    // Rotierender innerer 3D-Ring A
    Rectangle {
        property <angle> ring-angle:
            root.phase * 2deg;

        property <float> ring-depth:
            Math.abs(
                Math.cos(
                    ring-angle
                )
            );

        x:
            parent.width * 0.50
            - self.width / 2;

        y:
            parent.height * 0.18;

        width:
            parent.width
            * (
                0.16
                + ring-depth * 0.38
            );

        height:
            parent.height * 0.64;

        background: transparent;

        border-color:
            active
            ? #00ff66
            : #16512d;

        border-width: 1px;
        border-radius: self.width / 2;

        opacity:
            0.20
            + ring-depth * 0.55;
    }

    // Rotierender innerer 3D-Ring B
    Rectangle {
        property <angle> ring-angle:
            root.phase * 2deg + 90deg;

        property <float> ring-depth:
            Math.abs(
                Math.cos(
                    ring-angle
                )
            );

        x:
            parent.width * 0.50
            - self.width / 2;

        y:
            parent.height * 0.18;

        width:
            parent.width
            * (
                0.16
                + ring-depth * 0.38
            );

        height:
            parent.height * 0.64;

        background: transparent;

        border-color:
            active
            ? #8cffaa
            : #16512d;

        border-width: 1px;
        border-radius: self.width / 2;

        opacity:
            0.12
            + ring-depth * 0.38;
    }

    // Rotierender horizontaler 3D-Ring
    Rectangle {
        property <angle> tilt-angle:
            root.phase * 1.6deg;

        property <float> tilt-depth:
            Math.abs(
                Math.sin(
                    tilt-angle
                )
            );

        x:
            parent.width * 0.18;

        y:
            parent.height * 0.50
            - self.height / 2;

        width:
            parent.width * 0.64;

        height:
            parent.height
            * (
                0.08
                + tilt-depth * 0.28
            );

        background: transparent;

        border-color:
            active
            ? #00ff66
            : #16512d;

        border-width: 1px;
        border-radius: self.height / 2;

        opacity:
            0.18
            + tilt-depth * 0.50;
    }

    // Horizontaler Äquator
    Rectangle {
        x: parent.width * 0.18;
        y: parent.height * 0.49;
        width: parent.width * 0.64;
        height: 1px;

        background: active ? #00ff66 : #16512d;
    }

    // Vertikale Hauptachse
    Rectangle {
        x: parent.width * 0.50;
        y: parent.height * 0.18;
        width: 1px;
        height: parent.height * 0.64;

        background: #0b7a38;
    }

    // Linke Längengrad-Kurve
    Rectangle {
        x: parent.width * 0.31;
        y: parent.height * 0.18;
        width: parent.width * 0.19;
        height: parent.height * 0.64;

        background: transparent;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.width / 2;
    }

    // Rechte Längengrad-Kurve
    Rectangle {
        x: parent.width * 0.50;
        y: parent.height * 0.18;
        width: parent.width * 0.19;
        height: parent.height * 0.64;

        background: transparent;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.width / 2;
    }

    // Oberer Breitengrad
    Rectangle {
        x: parent.width * 0.22;
        y: parent.height * 0.33;
        width: parent.width * 0.56;
        height: parent.height * 0.13;

        background: transparent;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.height / 2;
    }

    // Unterer Breitengrad
    Rectangle {
        x: parent.width * 0.22;
        y: parent.height * 0.54;
        width: parent.width * 0.56;
        height: parent.height * 0.13;

        background: transparent;
        border-color: #0b7a38;
        border-width: 1px;
        border-radius: self.height / 2;
    }

    // Linkes Fadenkreuz
    Rectangle {
        x: parent.width * 0.04;
        y: parent.height * 0.50;
        width: parent.width * 0.10;
        height: 1px;

        background: #00ff66;
    }

    // Rechtes Fadenkreuz
    Rectangle {
        x: parent.width * 0.86;
        y: parent.height * 0.50;
        width: parent.width * 0.10;
        height: 1px;

        background: #00ff66;
    }

    // Oberes Fadenkreuz
    Rectangle {
        x: parent.width * 0.50;
        y: parent.height * 0.04;
        width: 1px;
        height: parent.height * 0.10;

        background: #00ff66;
    }

    // Unteres Fadenkreuz
    Rectangle {
        x: parent.width * 0.50;
        y: parent.height * 0.86;
        width: 1px;
        height: parent.height * 0.10;

        background: #00ff66;
    }

    // Eckmarkierungen
    Rectangle {
        x: 8px;
        y: 8px;
        width: 28px;
        height: 1px;
        background: #00ff66;
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: 1px;
        height: 28px;
        background: #00ff66;
    }

    Rectangle {
        x: parent.width - 36px;
        y: 8px;
        width: 28px;
        height: 1px;
        background: #00ff66;
    }

    Rectangle {
        x: parent.width - 9px;
        y: 8px;
        width: 1px;
        height: 28px;
        background: #00ff66;
    }

    Rectangle {
        x: 8px;
        y: parent.height - 9px;
        width: 28px;
        height: 1px;
        background: #00ff66;
    }

    Rectangle {
        x: 8px;
        y: parent.height - 36px;
        width: 1px;
        height: 28px;
        background: #00ff66;
    }

    Rectangle {
        x: parent.width - 36px;
        y: parent.height - 9px;
        width: 28px;
        height: 1px;
        background: #00ff66;
    }

    Rectangle {
        x: parent.width - 9px;
        y: parent.height - 36px;
        width: 1px;
        height: 28px;
        background: #00ff66;
    }

    // Fließender 3D-Datenpunkt
    Rectangle {
        property <float> progress:
            Math.mod(
                root.phase,
                120.0
            )
            / 120.0;

        x:
            parent.width * 0.28
            + progress
            * (
                parent.width * 0.44
            )
            - self.width / 2;

        y:
            parent.height * 0.62
            - progress
            * (
                parent.height * 0.28
            )
            - self.height / 2;

        width:
            4px
            + progress * 5px;

        height:
            4px
            + progress * 5px;

        background:
            active
            ? #8cffaa
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.35
            + progress * 0.65;
    }

    // Rotierender 3D-Orbit-Punkt
    Rectangle {
        property <angle> orbit-angle:
            root.phase * 3deg;

        property <float> depth:
            (
                Math.sin(
                    orbit-angle
                )
                + 1.0
            )
            / 2.0;

        x:
            parent.width * 0.50
            + Math.cos(
                orbit-angle
            )
            * (
                parent.width * 0.30
            )
            - self.width / 2;

        y:
            parent.height * 0.50
            + Math.sin(
                orbit-angle
            )
            * (
                parent.height * 0.18
            )
            - self.height / 2;

        width:
            4px
            + depth * 6px;

        height:
            4px
            + depth * 6px;

        background:
            active
            ? #00ff66
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.25
            + depth * 0.75;
    }

    // Zweiter gegenläufiger 3D-Orbit-Punkt
    Rectangle {
        property <angle> orbit-angle:
            root.phase * -2deg + 150deg;

        property <float> depth:
            (
                Math.cos(
                    orbit-angle
                )
                + 1.0
            )
            / 2.0;

        x:
            parent.width * 0.50
            + Math.cos(
                orbit-angle
            )
            * (
                parent.width * 0.24
            )
            - self.width / 2;

        y:
            parent.height * 0.50
            + Math.sin(
                orbit-angle
            )
            * (
                parent.height * 0.26
            )
            - self.height / 2;

        width:
            3px
            + depth * 5px;

        height:
            3px
            + depth * 5px;

        background:
            active
            ? #8cffaa
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.20
            + depth * 0.70;
    }

    // Bewegte Datenverbindung oben
    Rectangle {
        x: parent.width * 0.37;
        y: parent.height * 0.37;

        width: parent.width * 0.24;
        height: 1px;

        background: #0b7a38;
        opacity: 0.55;
    }

    Rectangle {
        property <float> stream:
            Math.mod(
                root.phase,
                100.0
            )
            / 100.0;

        x:
            parent.width * 0.37
            + stream
            * (
                parent.width * 0.24
                - 18px
            );

        y:
            parent.height * 0.37
            - 1px;

        width: 18px;
        height: 3px;

        background:
            active
            ? #00ff66
            : #16512d;

        opacity:
            0.35
            + stream * 0.65;
    }

    // Bewegte Datenverbindung unten
    Rectangle {
        x: parent.width * 0.43;
        y: parent.height * 0.59;

        width: parent.width * 0.22;
        height: 1px;

        background: #0b7a38;
        opacity: 0.50;
    }

    Rectangle {
        property <float> stream:
            Math.mod(
                root.phase + 50.0,
                100.0
            )
            / 100.0;

        x:
            parent.width * 0.43
            + stream
            * (
                parent.width * 0.22
                - 16px
            );

        y:
            parent.height * 0.59
            - 1px;

        width: 16px;
        height: 3px;

        background:
            active
            ? #8cffaa
            : #16512d;

        opacity:
            0.30
            + stream * 0.60;
    }

    // Vertikaler Datenstrom zum Zentrum
    Rectangle {
        x: parent.width * 0.50;
        y: parent.height * 0.27;

        width: 1px;
        height: parent.height * 0.20;

        background: #0b7a38;
        opacity: 0.45;
    }

    Rectangle {
        property <float> stream:
            Math.mod(
                root.phase + 25.0,
                90.0
            )
            / 90.0;

        x:
            parent.width * 0.50
            - 1px;

        y:
            parent.height * 0.27
            + stream
            * (
                parent.height * 0.20
                - 14px
            );

        width: 3px;
        height: 14px;

        background:
            active
            ? #00ff66
            : #16512d;

        opacity:
            0.35
            + stream * 0.65;
    }

    // Pulsierende Netzwerk-Knoten
    Rectangle {
        property <float> pulse:
            (
                Math.sin(
                    root.phase * 4deg
                )
                + 1.0
            )
            / 2.0;

        width:
            4px
            + pulse * 4px;

        height:
            self.width;

        x:
            parent.width * 0.37
            - self.width / 2;

        y:
            parent.height * 0.35
            - self.height / 2;

        background:
            active
            ? #00ff66
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.45
            + pulse * 0.55;
    }

    Rectangle {
        property <float> pulse:
            (
                Math.sin(
                    root.phase * 4deg
                    + 72deg
                )
                + 1.0
            )
            / 2.0;

        width:
            4px
            + pulse * 4px;

        height:
            self.width;

        x:
            parent.width * 0.61
            - self.width / 2;

        y:
            parent.height * 0.39
            - self.height / 2;

        background:
            active
            ? #00ff66
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.45
            + pulse * 0.55;
    }

    Rectangle {
        property <float> pulse:
            (
                Math.sin(
                    root.phase * 4deg
                    + 144deg
                )
                + 1.0
            )
            / 2.0;

        width:
            4px
            + pulse * 4px;

        height:
            self.width;

        x:
            parent.width * 0.43
            - self.width / 2;

        y:
            parent.height * 0.58
            - self.height / 2;

        background:
            active
            ? #00ff66
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.45
            + pulse * 0.55;
    }

    Rectangle {
        property <float> pulse:
            (
                Math.sin(
                    root.phase * 4deg
                    + 216deg
                )
                + 1.0
            )
            / 2.0;

        width:
            4px
            + pulse * 4px;

        height:
            self.width;

        x:
            parent.width * 0.65
            - self.width / 2;

        y:
            parent.height * 0.60
            - self.height / 2;

        background:
            active
            ? #00ff66
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.45
            + pulse * 0.55;
    }

    Rectangle {
        property <float> pulse:
            (
                Math.sin(
                    root.phase * 4deg
                    + 288deg
                )
                + 1.0
            )
            / 2.0;

        width:
            4px
            + pulse * 4px;

        height:
            self.width;

        x:
            parent.width * 0.50
            - self.width / 2;

        y:
            parent.height * 0.27
            - self.height / 2;

        background:
            active
            ? #8cffaa
            : #16512d;

        border-radius:
            self.width / 2;

        opacity:
            0.45
            + pulse * 0.55;
    }

    // Bewegte Scan-Linie
    Rectangle {
        x:
            parent.width * 0.18
            + (
                Math.mod(
                    root.phase,
                    180.0
                )
                / 180.0
            )
            * (
                parent.width * 0.64
            );

        y: parent.height * 0.18;

        width: 2px;
        height: parent.height * 0.64;

        background:
            active
            ? #00ff66
            : #16512d;

        opacity: 0.90;
    }

    // Leichter Glow direkt hinter der Scan-Linie
    Rectangle {
        x:
            parent.width * 0.18
            + (
                Math.mod(
                    root.phase,
                    180.0
                )
                / 180.0
            )
            * (
                parent.width * 0.64
            )
            - 4px;

        y: parent.height * 0.18;

        width: 8px;
        height: parent.height * 0.64;

        background:
            active
            ? #00ff66
            : #16512d;

        opacity: 0.08;
    }

    // Zentrum
    Rectangle {
        x: parent.width * 0.38;
        y: parent.height * 0.43;
        width: parent.width * 0.24;
        height: parent.height * 0.14;

        background: #010805;
        border-color: #00ff66;
        border-width: 1px;

        Text {
            width: parent.width;
            height: parent.height;

            text: root.center-text;

            color: #00ff66;
            font-size: 11px;
            font-weight: 700;

            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Status unten
    Text {
        x: 10px;
        y: parent.height - 26px;
        width: parent.width - 20px;
        height: 16px;

        text: "● " + root.status-text;

        color: active ? #00ff66 : #4b7a5b;
        font-size: 9px;
        font-weight: 700;

        horizontal-alignment: center;
    }
}
