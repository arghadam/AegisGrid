component ProcessInventoryButton inherits Rectangle {
    in property <string> text: "";
    callback clicked();

    background: #03140a;
    border-color: #0b5c2b;
    border-width: 1px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #00ff66;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.clicked();
    }
}

export component ProcessInventoryScreen inherits Rectangle {
    in property <string> hostname: "—";
    in-out property <string> suchbegriff: "";
    in property <string> status: "BEREIT";
    in property <string> gesamt: "0";
    in property <string> treffer: "0";
    in property <string> tabelle: "—";

    callback aktualisieren(string);
    callback zurueck();

    background: #010604;

    for grid-x in 24 : Rectangle {
        x: grid-x * 64px;
        width: 1px;
        height: parent.height;
        background: #06351a;
        opacity: 0.10;
    }

    for grid-y in 16 : Rectangle {
        y: grid-y * 56px;
        width: parent.width;
        height: 1px;
        background: #06351a;
        opacity: 0.10;
    }

    Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: 68px;
        background: #03140a;
        border-color: #00ff66;
        border-width: 1px;

        ProcessInventoryButton {
            x: 14px;
            y: 14px;
            width: 120px;
            height: 40px;
            text: "< PROZESSE";
            clicked => root.zurueck();
        }

        Text {
            x: 154px;
            width: 540px;
            height: parent.height;
            text: "AEGISGRID // PROZESS-EXPLORER";
            color: #00ff66;
            font-size: 19px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 280px;
            width: 260px;
            height: parent.height;
            text: "HOST: " + root.hostname;
            color: #8cffaa;
            font-size: 10px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 18px;
        y: 104px;
        width: parent.width - 36px;
        height: 82px;
        background: #020906;
        border-color: #0b5c2b;
        border-width: 1px;

        Text {
            x: 14px;
            y: 10px;
            width: 160px;
            height: 16px;
            text: "SUCHE // PID, NAME, PFAD";
            color: #57b578;
            font-size: 9px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 32px;
            width: parent.width - 370px;
            height: 38px;
            background: #010805;
            border-color: process-search.has-focus ? #00ff66 : #0b5c2b;
            border-width: 1px;

            process-search := TextInput {
                x: 10px;
                y: 7px;
                width: parent.width - 20px;
                height: parent.height - 14px;
                text <=> root.suchbegriff;
                color: #00ff66;
                font-size: 11px;
                single-line: true;
                accepted => root.aktualisieren(root.suchbegriff);
            }
        }

        ProcessInventoryButton {
            x: parent.width - 342px;
            y: 32px;
            width: 154px;
            height: 38px;
            text: "SUCHEN / AKTUALISIEREN";
            clicked => root.aktualisieren(root.suchbegriff);
        }

        ProcessInventoryButton {
            x: parent.width - 176px;
            y: 32px;
            width: 162px;
            height: 38px;
            text: "FILTER LÖSCHEN";
            clicked => {
                root.suchbegriff = "";
                root.aktualisieren("");
            }
        }
    }

    Rectangle {
        x: 18px;
        y: 202px;
        width: 240px;
        height: 76px;
        background: #020906;
        border-color: #0b5c2b;
        border-width: 1px;

        Text {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            height: 16px;
            text: "PROZESSE GESAMT";
            color: #3c8d58;
            font-size: 9px;
        }

        Text {
            x: 14px;
            y: 34px;
            width: parent.width - 28px;
            height: 28px;
            text: root.gesamt;
            color: #00ff66;
            font-size: 20px;
            font-weight: 700;
        }
    }

    Rectangle {
        x: 272px;
        y: 202px;
        width: 240px;
        height: 76px;
        background: #020906;
        border-color: #0b5c2b;
        border-width: 1px;

        Text {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            height: 16px;
            text: "TREFFER";
            color: #3c8d58;
            font-size: 9px;
        }

        Text {
            x: 14px;
            y: 34px;
            width: parent.width - 28px;
            height: 28px;
            text: root.treffer;
            color: #00ff66;
            font-size: 20px;
            font-weight: 700;
        }
    }

    Text {
        x: 532px;
        y: 202px;
        width: parent.width - 550px;
        height: 76px;
        text: "STATUS: " + root.status + "\nSortierung: CPU absteigend // maximal 120 sichtbare Treffer";
        color: #57b578;
        font-size: 10px;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    Rectangle {
        x: 18px;
        y: 294px;
        width: parent.width - 36px;
        height: parent.height - 312px;
        background: #000402;
        border-color: #0b5c2b;
        border-width: 1px;
        clip: true;

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: 18px;
            text: "PID | CPU | RAM | PROZESS // AUSFÜHRUNGSPFAD";
            color: #57b578;
            font-size: 9px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 38px;
            width: parent.width - 28px;
            height: 1px;
            background: #0b5c2b;
        }

        Text {
            x: 14px;
            y: 52px;
            width: parent.width - 28px;
            height: parent.height - 66px;
            text: root.tabelle;
            color: #00ff66;
            font-size: 9px;
            wrap: word-wrap;
        }
    }
}
