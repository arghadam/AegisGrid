import { EingabeFeld } from "../components/eingabe_feld.slint";

export component LoginScreen inherits Rectangle {
    in-out property <string> benutzername: "";
    in-out property <string> kennwort: "";
    in-out property <string> statusmeldung: "";
    in property <bool> touch-id-verfuegbar: false;

    callback absenden(string, string);
    callback touch-id-absenden();

    background: #010604;

    for grid-x in 24 : Rectangle {
        x: grid-x * 64px;
        width: 1px;
        height: parent.height;
        background: #06351a;
        opacity: 0.12;
    }

    for grid-y in 16 : Rectangle {
        y: grid-y * 56px;
        width: parent.width;
        height: 1px;
        background: #06351a;
        opacity: 0.12;
    }

    Rectangle {
        x: parent.width / 2 - 280px;
        y: parent.height / 2 - 245px;
        width: 560px;
        height: 490px;
        background: #020906;
        border-color: #00ff66;
        border-width: 1px;

        Text {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: 35px;
            text: "AEGISGRID // ZUGRIFFSKONTROLLE";
            color: #00ff66;
            font-size: 21px;
            font-weight: 700;
        }

        Text {
            x: 28px;
            y: 66px;
            width: parent.width - 56px;
            height: 24px;
            text: "LOKALE AUTHENTIFIZIERUNG // ZERO-CLEARTEXT";
            color: #57b578;
            font-size: 10px;
        }

        EingabeFeld {
            x: 28px;
            y: 112px;
            width: parent.width - 56px;
            label: "BENUTZERNAME";
            wert <=> root.benutzername;
        }

        EingabeFeld {
            x: 28px;
            y: 202px;
            width: parent.width - 56px;
            label: "KENNWORT";
            wert <=> root.kennwort;
            kennwort: true;
        }

        Text {
            x: 28px;
            y: 296px;
            width: parent.width - 56px;
            height: 38px;
            text: root.statusmeldung;
            color: #ff4d4d;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 28px;
            y: 350px;
            width: touch-id-verfuegbar ? (parent.width - 68px) * 0.64 : parent.width - 56px;
            height: 54px;
            background: #03140a;
            border-color: #00ff66;
            border-width: 1px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "ANMELDEN >";
                color: #00ff66;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => root.absenden(root.benutzername, root.kennwort);
            }
        }

        if root.touch-id-verfuegbar : Rectangle {
            x: parent.width - 190px;
            y: 350px;
            width: 162px;
            height: 54px;
            background: #03140a;
            border-color: #0b5c2b;
            border-width: 1px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "TOUCH ID";
                color: #8cffaa;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => root.touch-id-absenden();
            }
        }
    }
}
