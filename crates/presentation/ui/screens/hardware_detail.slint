component HardwareButton inherits Rectangle {
    in property <string> text: "";
    callback clicked();
    background: #03140a;
    border-color: #0b5c2b;
    border-width: 1px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #00ff66;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.clicked();
    }
}

export component HardwareDetailScreen inherits Rectangle {
    in property <string> hostname: "—";
    in property <string> status: "BEREIT";
    in property <string> cpu: "—";
    in property <string> cores: "—";
    in property <string> memory: "—";
    in property <string> disks: "—";
    in property <string> sensors: "—";

    callback aktualisieren();
    callback zurueck();

    background: #010604;

    for grid-x in 24 : Rectangle {
        x: grid-x * 64px;
        width: 1px;
        height: parent.height;
        background: #06351a;
        opacity: 0.10;
    }

    for grid-y in 16 : Rectangle {
        y: grid-y * 56px;
        width: parent.width;
        height: 1px;
        background: #06351a;
        opacity: 0.10;
    }

    Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: 68px;
        background: #03140a;
        border-color: #00ff66;
        border-width: 1px;

        HardwareButton {
            x: 14px;
            y: 14px;
            width: 120px;
            height: 40px;
            text: "< DASHBOARD";
            clicked => root.zurueck();
        }

        Text {
            x: 154px;
            width: 500px;
            height: parent.height;
            text: "AEGISGRID // HARDWARE & SENSOREN";
            color: #00ff66;
            font-size: 19px;
            font-weight: 700;
            vertical-alignment: center;
        }

        HardwareButton {
            x: parent.width - 350px;
            y: 14px;
            width: 150px;
            height: 40px;
            text: "AKTUALISIEREN";
            clicked => root.aktualisieren();
        }

        Text {
            x: parent.width - 190px;
            width: 170px;
            height: parent.height;
            text: "HOST: " + root.hostname;
            color: #8cffaa;
            font-size: 10px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 18px;
        y: 104px;
        width: parent.width - 36px;
        height: 170px;
        background: #020906;
        border-color: #0b5c2b;
        border-width: 1px;

        Text {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: 18px;
            text: "SYSTEM-HARDWARE // " + root.status;
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Text {
            x: 16px;
            y: 42px;
            width: parent.width - 32px;
            height: 26px;
            text: "CPU: " + root.cpu;
            color: #00ff66;
            font-size: 13px;
            font-weight: 700;
        }

        Text {
            x: 16px;
            y: 76px;
            width: parent.width - 32px;
            height: 26px;
            text: "KERNE: " + root.cores;
            color: #00ff66;
            font-size: 12px;
        }

        Text {
            x: 16px;
            y: 110px;
            width: parent.width - 32px;
            height: 26px;
            text: "ARBEITSSPEICHER: " + root.memory;
            color: #00ff66;
            font-size: 12px;
        }
    }

    Rectangle {
        x: 18px;
        y: 290px;
        width: (parent.width - 54px) * 0.54;
        height: parent.height - 308px;
        background: #000402;
        border-color: #0b5c2b;
        border-width: 1px;
        clip: true;

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: 20px;
            text: "DATENTRÄGER";
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 40px;
            width: parent.width - 28px;
            height: 1px;
            background: #0b5c2b;
        }

        Text {
            x: 14px;
            y: 54px;
            width: parent.width - 28px;
            height: parent.height - 68px;
            text: root.disks;
            color: #00ff66;
            font-size: 10px;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: 36px + (parent.width - 54px) * 0.54;
        y: 290px;
        width: (parent.width - 54px) * 0.46;
        height: parent.height - 308px;
        background: #000402;
        border-color: #0b5c2b;
        border-width: 1px;
        clip: true;

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: 20px;
            text: "TEMPERATUR-SENSOREN";
            color: #57b578;
            font-size: 10px;
            font-weight: 700;
        }

        Rectangle {
            x: 14px;
            y: 40px;
            width: parent.width - 28px;
            height: 1px;
            background: #0b5c2b;
        }

        Text {
            x: 14px;
            y: 54px;
            width: parent.width - 28px;
            height: parent.height - 68px;
            text: root.sensors;
            color: #00ff66;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}
